[user]
default = "{{ target_username }}"

[appearance]
scheme = "Synced"
hide_logo = true

[clock]
enabled = true
position = "above-panel"
time_format = "{:%H:%M}"
date_format = "%A, %x"
time_font_size = 300
date_font_size = 50

[cursor]
theme = "Bibata-Modern-Classic"
size = 24
path = "/usr/share/icons/"
