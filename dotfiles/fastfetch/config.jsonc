{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/images/epicurus.png",
    "width": 50
  },
  "display": {
    "key": { "width": 9 },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "35",
        "host": "36"
      }
    },
    "break",

    {
      "type": "custom",
      "format": "{#31}\u2500\u2500{#} VITALS \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    { "type": "cpu", "key": "CPU", "keyColor": "31" },
    { "type": "gpu", "key": "GPU", "detectionMethod": "pci", "keyColor": "31" },
    { "type": "memory", "key": "MEM", "keyColor": "31" },
    { "type": "disk", "key": "DISK", "keyColor": "31" },
    { "type": "monitor", "key": "DISPLAY", "keyColor": "31" },
    "break",

    {
      "type": "custom",
      "format": "{#32}\u2500\u2500{#} SYSTEM \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    { "type": "os", "key": "OS", "keyColor": "32" },
    { "type": "kernel", "key": "KERNEL", "keyColor": "32" },
    { "type": "packages", "key": "PKGS", "keyColor": "32" },
    { "type": "wm", "key": "WM", "keyColor": "32" },
    { "type": "theme", "key": "THEME", "keyColor": "32" },
    { "type": "terminalfont", "key": "FONT", "keyColor": "32" },
    { "type": "icons", "key": "ICON", "keyColor": "32" },
    { "type": "cursor", "key": "CURSOR", "keyColor": "32" },
    {
      "type": "command",
      "key": "SHELL",
      "text": "basename \"${SHELL:-unknown}\"",
      "keyColor": "32"
    },
    "break",

    {
      "type": "custom",
      "format": "{#33}\u2500\u2500{#} SESSION \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"
    },
    { "type": "uptime", "key": "UPTIME", "keyColor": "33" },
    {
      "type": "command",
      "key": "AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days",
      "keyColor": "33"
    },
    { "type": "terminal", "key": "TERM", "keyColor": "33" },
    "break",

    {
      "type": "colors",
      "symbol": "circle",
      "brightness": "normal"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "brightness": "light"
    }
  ]
}
