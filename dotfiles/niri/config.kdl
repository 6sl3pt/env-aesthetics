input {
    keyboard {
        xkb {
            layout "us,th"
            options "grp:win_space_toggle"
        }

        numlock
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    trackpoint {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }
}

/-output "eDP-1" {
    // off
    mode "1920x1080"
    scale 2
    transform "normal"
    position x=1280 y=0
}

spawn-at-startup "noctalia"

include "./cfg/keybinds.kdl"
include "./cfg/layout.kdl"
include "./cfg/misc.kdl"
include "./cfg/rules.kdl"

include "noctalia.kdl"
